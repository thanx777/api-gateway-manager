# API Gateway Manager - 环境配置
# 复制此文件为 .env 后修改

# ---- 代理服务端口 ----
# PORT=3001

# ---- 默认目标 API（可通过前端 UI 动态修改） ----
# 以下仅为初始默认值，UI 配置会覆盖它们
# TARGET_API_URL=https://api.openai.com/v1/chat/completions
# TARGET_API_KEY=sk-your-key-here
# DEFAULT_MODEL=gpt-4-turbo

# ---- 输出 token 上限 ----
# CC 默认请求 32000 max_tokens（针对 Claude 200K 窗口），
# 第三方模型通常窗口较小，代理会自动截断到该值
# MAX_OUTPUT_TOKENS=8192

# ---- 工具调用 ----
# 工具调用通过前端 API 配置界面按需控制（"启用工具调用" 复选框）
# 代理会自动在系统提示中注入工具使用规范，防止非 Claude 模型误触发工具
